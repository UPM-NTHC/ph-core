@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://fhir.doh.gov.ph/phcore/Condition/example-condition> a fhir:Condition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example-condition"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\">Juan Dela Cruz has an active diagnosis of Type 2 Diabetes Mellitus.</div>"
  ] ;
  fhir:Condition.clinicalStatus [
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/condition-clinical" ] ;
       fhir:Coding.code [ fhir:value "active" ] ;
       fhir:Coding.display [ fhir:value "Active" ]
     ]
  ] ;
  fhir:Condition.code [
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       a sct:44054006 ;
       fhir:Coding.system [ fhir:value "http://snomed.info/sct" ] ;
       fhir:Coding.code [ fhir:value "44054006" ] ;
       fhir:Coding.display [ fhir:value "Diabetes mellitus type 2" ]
     ]
  ] ;
  fhir:Condition.subject [
     fhir:link <https://fhir.doh.gov.ph/phcore/Patient/example-patient> ;
     fhir:Reference.reference [ fhir:value "Patient/example-patient" ]
  ] ;
  fhir:Condition.encounter [
     fhir:link <https://fhir.doh.gov.ph/phcore/Encounter/example-encounter> ;
     fhir:Reference.reference [ fhir:value "Encounter/example-encounter" ]
  ] .

# - ontology header ------------------------------------------------------------

<https://fhir.doh.gov.ph/phcore/Condition/example-condition.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

# -------------------------------------------------------------------------------------

