@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://fhir.doh.gov.ph/phcore/Practitioner/example-practitioner> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example-practitioner"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://fhir.doh.gov.ph/phcore/StructureDefinition/ph-core-practitioner" ;
       fhir:index 0 ;
       fhir:link <https://fhir.doh.gov.ph/phcore/StructureDefinition/ph-core-practitioner>
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\">Dr. Maria Clara Santos is a female practitioner born on May 15, 1985. She resides at 1234 Mabini Street, Manila, NCR, 1000, Philippines. She can be contacted via mobile at +63-912-345-6789 or by email at maria.santos@example.ph.</div>"
  ] ;
  fhir:Practitioner.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Santos" ] ;
     fhir:HumanName.given [
       fhir:value "Maria" ;
       fhir:index 0
     ], [
       fhir:value "Clara" ;
       fhir:index 1
     ]
  ] ;
  fhir:Practitioner.telecom [
     fhir:index 0 ;
     fhir:ContactPoint.system [ fhir:value "phone" ] ;
     fhir:ContactPoint.value [ fhir:value "+63-912-345-6789" ] ;
     fhir:ContactPoint.use [ fhir:value "mobile" ]
  ], [
     fhir:index 1 ;
     fhir:ContactPoint.system [ fhir:value "email" ] ;
     fhir:ContactPoint.value [ fhir:value "maria.santos@example.ph" ] ;
     fhir:ContactPoint.use [ fhir:value "work" ]
  ] ;
  fhir:Practitioner.address [
     fhir:index 0 ;
     fhir:Address.use [ fhir:value "home" ] ;
     fhir:Address.line [
       fhir:value "1234 Mabini Street" ;
       fhir:index 0
     ] ;
     fhir:Address.city [ fhir:value "Manila" ] ;
     fhir:Address.state [ fhir:value "NCR" ] ;
     fhir:Address.postalCode [ fhir:value "1000" ] ;
     fhir:Address.country [ fhir:value "PH" ]
  ] ;
  fhir:Practitioner.gender [ fhir:value "female"] ;
  fhir:Practitioner.birthDate [ fhir:value "1985-05-15"^^xsd:date] .

# - ontology header ------------------------------------------------------------

<https://fhir.doh.gov.ph/phcore/Practitioner/example-practitioner.ttl> a owl:Ontology ;
