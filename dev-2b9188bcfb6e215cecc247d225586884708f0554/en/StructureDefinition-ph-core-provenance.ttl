  fhir:StructureDefinition.date [ fhir:value "2026-09-09T08:40:24+00:00"^^xsd:dateTime] ;
  fhir:StructureDefinition.publisher [ fhir:value "UP Manila National TeleHealth Center"] ;
  fhir:StructureDefinition.contact [
