  fhir:CapabilityStatement.description [ fhir:value "Requirements and selectable capability catalog for systems responding to PH Core FHIR API requests, including standard retrieval and conditional atomic ingestion."] ;
  fhir:CapabilityStatement.kind [ fhir:value "requirements"] ;
  fhir:CapabilityStatement.fhirVersion [ fhir:value "4.0.1"] ;
  fhir:CapabilityStatement.format [
