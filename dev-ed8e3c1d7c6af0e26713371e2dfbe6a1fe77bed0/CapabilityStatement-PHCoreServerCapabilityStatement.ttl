  fhir:CapabilityStatement.rest [
     fhir:index 0 ;
     fhir:CapabilityStatement.rest.mode [ fhir:value "server" ] ;
     fhir:CapabilityStatement.rest.documentation [ fhir:value "The PH Core Server SHALL support at least one relevant PH Core resource profile. Resource selection is optional; once selected for REST access, its listed profile, read, search and SHALL filters/combinations apply. Patient-centric exchange SHALL support PH Core Patient for the exchanged patient context; provider/facility directories need not implement Patient solely for Server conformance. Create and update remain optional. A Server declaring create SHALL support conditional create; a Server declaring update SHALL support conditional update and version-aware updates. The catalog's conditionalCreate, conditionalUpdate, versioning and transaction SHALL expectations have this documented applicability and do not require read-only Servers to implement writes. The minimum version policy is versioned; versioned-update also satisfies the requirement. Write-enabled ingestion means create or update is supported for at least one selected PH Core resource; such Servers SHALL support atomic transaction Bundles for their supported resources. Servers SHALL support GET and POST search, paging, _count and the search semantics and combinations specified in [Client and Server conformance](client-server-conformance.html). Servers SHALL return conformant JSON, enforce authorization, and fulfill profile constraints and applicable actor obligations. They SHALL publish an implementation-specific kind=instance CapabilityStatement at GET [base]/metadata, use instantiates for this requirements statement, and declare their actual selected PH profiles, supported interactions, conditional/versioning policies, searches, joins, operations, formats and security arrangements. They SHOULD identify conforming profiles in meta.profile. A dual-role implementation MAY instantiate both PH requirements statements with client and server REST blocks. Profile-only conformance does not require the REST contract. Supporting a profile or search does not mandate a program workflow or new data capture." ] ;
     fhir:CapabilityStatement.rest.security [
       fhir:CapabilityStatement.rest.security.description [ fhir:value "The Server SHALL use HTTPS for production exchange, apply deployment authorization/consent policies and reject unauthorized requests using appropriate FHIR responses. Invalid requests, unknown resources and insufficient authorization SHALL produce appropriate 400, 404 and 401/403 responses, subject to FHIR security behavior. OperationOutcome content SHALL follow FHIR rules. Deployment or downstream guides SHALL define authentication, authorization, consent, trust and audit arrangements." ]
     ] ;
