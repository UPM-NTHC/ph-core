  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ActorDefinition PHCoreServer</b></p><a name=\"PHCoreServer\"> </a><a name=\"hcPHCoreServer\"> </a><table class=\"grid\"><tr><td><b>Actor: PHCoreServer </b></td><td>PH Core Server</td><td>Type: system </td></tr><tr><td colspan=\"3\"><div><p>A PH Core Server accepts FHIR API requests and provides responses containing PH Core resources. It fulfills population obligations when producing response resources and correctly handles resources in supported incoming write requests. It may store, generate, aggregate or proxy resources; it is not required to originate clinical facts or support every write interaction. The role applies to the request being answered; a system may also act as a PH Core Client in other exchanges. The API requirements are defined in the <a href=\"CapabilityStatement-PHCoreServerCapabilityStatement.html\">PH Core Server CapabilityStatement</a>.</p>\n</div></td></tr></table></div>"
  ] ;
