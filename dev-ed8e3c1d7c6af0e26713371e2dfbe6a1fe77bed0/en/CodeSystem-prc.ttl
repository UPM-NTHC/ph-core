  ] ;
  fhir:CodeSystem.description [ fhir:value "Consolidated PH Core terminology for PRC CPDAS Council codes, CPDAS numerical profession codes, and PRC licensure examination codes. CPDAS council and profession concepts reflect the FAQ as of 12 January 2021; PRC examination concepts reflect the standardized list posted 18 March 2026. The hierarchy groups related concepts and does not assert an is-a relationship. The 2021 CPDAS table says its numeric profession codes are for CPD attendance sheets and is subject to regular updating. The 2026 Food Technology and Speech-Language Pathology examination boards have abstract local grouping nodes because the 2021 CPDAS table has no council codes for them; those nodes are not CouncilCode values."] ;
  fhir:CodeSystem.jurisdiction [
     fhir:index -1 ;
     fhir:CodeableConcept.coding [
       fhir:index -1 ;
       fhir:Coding.system [ fhir:value "urn:iso:std:iso:3166" ] ;
       fhir:Coding.code [ fhir:value "PH" ] ;
       fhir:Coding.display [ fhir:value "Philippines" ]
     ]
  ] ;
  fhir:CodeSystem.purpose [ fhir:value "Provide one grouped terminology namespace while preserving PRC council codes, numerical profession codes, and examination codes as distinct concepts."] ;
  fhir:CodeSystem.caseSensitive [ fhir:value "true"^^xsd:boolean] ;
  fhir:CodeSystem.valueSet [
     fhir:value "https://fhir.doh.gov.ph/phcore/ValueSet/prc-all-codes" ;
